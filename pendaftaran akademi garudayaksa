<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Pendaftaran Akademi Garudayaksa</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        linear-gradient(rgba(0, 0, 0, .65), rgba(0, 45, 25, .75)),
        linear-gradient(135deg, #031b11, #08743c);
      padding: 30px 15px;
      color: #222;
    }

    .container {
      max-width: 950px;
      margin: auto;
    }

    /* HEADER */
    .header {
      text-align: center;
      color: white;
      margin-bottom: 30px;
    }

    .logo {
      width: 95px;
      height: 95px;
      margin: 0 auto 15px;

      border-radius: 50%;
      background: white;
      border: 5px solid #f5c400;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 45px;
      box-shadow: 0 8px 25px rgba(0,0,0,.3);
    }

    .header h1 {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #fff;
    }

    .header h1 span {
      color: #f5c400;
    }

    .header p {
      margin-top: 8px;
      color: #d8f5e4;
      font-size: 15px;
    }

    /* CARD */
    .form-card {
      background: #fff;
      border-radius: 20px;
      padding: 35px;
      box-shadow: 0 20px 50px rgba(0,0,0,.3);
    }

    /* SECTION */
    .section {
      margin-bottom: 32px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 20px;
      font-weight: 800;
      color: #08743c;

      padding-bottom: 12px;
      margin-bottom: 20px;

      border-bottom: 2px solid #eeeeee;
    }

    .section-title span {
      width: 35px;
      height: 35px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;
      background: #08743c;
      color: white;
    }

    /* GRID */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 7px;
      color: #333;
    }

    .required {
      color: #e63946;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 13px 14px;

      border: 1px solid #d7d7d7;
      border-radius: 9px;

      font-size: 14px;
      color: #333;

      outline: none;
      transition: .2s;
      background: #fff;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #08743c;
      box-shadow: 0 0 0 3px rgba(8,116,60,.12);
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    /* RADIO */
    .radio-group {
      display: flex;
      gap: 25px;
      margin-top: 8px;
    }

    .radio-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-weight: normal;
    }

    .radio-item input {
      width: auto;
    }

    /* FOTO */
    .photo-box {
      border: 2px dashed #bdbdbd;
      border-radius: 10px;
      padding: 25px;
      text-align: center;
      background: #fafafa;
    }

    .photo-box p {
      font-size: 13px;
      color: #777;
      margin-bottom: 10px;
    }

    .photo-box input {
      border: none;
      padding: 5px;
    }

    /* AGREEMENT */
    .agreement {
      background: #f0faf4;
      border-left: 4px solid #08743c;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .agreement label {
      display: flex;
      gap: 10px;
      line-height: 1.5;
      font-weight: normal;
      margin: 0;
    }

    .agreement input {
      width: auto;
      margin-top: 4px;
      flex-shrink: 0;
    }

    /* BUTTON */
    .submit-btn {
      width: 100%;
      padding: 16px;

      border: none;
      border-radius: 10px;

      background: linear-gradient(135deg, #08743c, #0ba957);
      color: white;

      font-size: 17px;
      font-weight: 800;

      cursor: pointer;
      transition: .25s;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(8,116,60,.3);
    }

    /* FOOTER */
    .footer {
      text-align: center;
      color: #d8f5e4;
      margin-top: 20px;
      font-size: 13px;
    }

    /* SUCCESS */
    .success {
      display: none;
      text-align: center;
      padding: 25px;
      margin-bottom: 25px;
      border-radius: 12px;
      background: #eaf9f0;
      color: #08743c;
      border: 1px solid #a8dfbd;
    }

    .success .check {
      font-size: 45px;
      margin-bottom: 10px;
    }

    /* MOBILE */
    @media (max-width: 650px) {

      body {
        padding: 20px 10px;
      }

      .form-card {
        padding: 22px 18px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .full {
        grid-column: auto;
      }

      .header h1 {
        font-size: 26px;
      }

      .logo {
        width: 80px;
        height: 80px;
        font-size: 36px;
      }

      .radio-group {
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- HEADER -->
    <div class="header">

      <div class="logo">
        🦅
      </div>

      <h1>
        AKADEMI <span>GARUDAYAKSA</span>
      </h1>

      <p>
        Formulir Pendaftaran Calon Pemain
      </p>

    </div>


    <!-- FORM CARD -->
    <div class="form-card">

      <!-- SUCCESS MESSAGE -->
      <div class="success" id="successMessage">

        <div class="check">✅</div>

        <h3>Pendaftaran Berhasil!</h3>

        <p>
          Data calon pemain telah berhasil dikirim.
          Tim Akademi Garudayaksa akan menghubungi Anda
          untuk informasi selanjutnya.
        </p>

      </div>


      <form id="registrationForm">

        <!-- DATA PEMAIN -->
        <div class="section">

          <div class="section-title">
            <span>1</span>
            Data Calon Pemain
          </div>

          <div class="form-grid">

            <div class="form-group full">

              <label>
                Nama Lengkap
                <span class="required">*</span>
              </label>

              <input
                type="text"
                name="nama"
                placeholder="Masukkan nama lengkap pemain"
                required
              >

            </div>


            <div class="form-group">

              <label>
                Tempat Lahir
                <span class="required">*</span>
              </label>

              <input
                type="text"
                name="tempat_lahir"
                placeholder="Contoh: Jakarta"
                required
              >

            </div>


            <div class="form-group">

              <label>
                Tanggal Lahir
                <span class="required">*</span>
              </label>

              <input
                type="date"
                name="tanggal_lahir"
                required
              >

            </div>


            <div class="form-group">

              <label>
                Jenis Kelamin
                <span class="required">*</span>
              </label>

              <div class="radio-group">

                <label class="radio-item">
                  <input
                    type="radio"
                    name="jenis_kelamin"
                    value="Laki-laki"
                    required
                  >
                  Laki-laki
                </label>

                <label class="radio-item">
                  <input
                    type="radio"
                    name="jenis_kelamin"
                    value="Perempuan"
                  >
                  Perempuan
                </label>

              </div>

            </div>


            <div class="form-group">

              <label>
                Kelompok Usia
                <span class="required">*</span>
              </label>

              <select name="kelompok" required>

                <option value="">
                  -- Pilih Kelompok --
                </option>

                <option value="U-8">U-8</option>
                <option value="U-10">U-10</option>
                <option value="U-12">U-12</option>
                <option value="U-14">U-14</option>
                <option value="U-16">U-16</option>
                <option value="U-18">U-18</option>

              </select>

            </div>


            <div class="form-group">

              <label>
                Posisi Bermain
                <span class="required">*</span>
              </label>

              <select name="posisi" required>

                <option value="">
                  -- Pilih Posisi --
                </option>

                <option value="GK">
                  Goalkeeper (GK)
                </option>

                <option value="DF">
                  Defender (DF)
                </option>

                <option value="MF">
                  Midfielder (MF)
                </option>

                <option value="FW">
                  Forward (FW)
                </option>

              </select>

            </div>


            <div class="form-group">

              <label>
                Nomor Punggung Favorit
              </label>

              <input
                type="number"
                name="nomor"
                min="1"
                max="99"
                placeholder="Contoh: 10"
              >

            </div>


            <div class="form-group">

              <label>
                Tinggi Badan (cm)
              </label>

              <input
                type="number"
                name="tinggi"
                placeholder="Contoh: 150"
              >

            </div>


            <div class="form-group">

              <label>
                Berat Badan (kg)
              </label>

              <input
                type="number"
                name="berat"
                placeholder="Contoh: 45"
              >

            </div>


            <div class="form-group full">

              <label>
                Alamat Lengkap
                <span class="required">*</span>
              </label>

              <textarea
                name="alamat"
                placeholder="Masukkan alamat lengkap pemain"
                required
              ></textarea>

            </div>

          </div>

        </div>


        <!-- FOTO -->
        <div class="section">

          <div class="section-title">
            <span>2</span>
            Foto Pemain
          </div>

          <div class="photo-box">

            <p>
              Upload foto terbaru calon pemain
            </p>

            <input
              type="file"
              name="foto"
              accept="image/*"
            >

          </div>

        </div>


        <!-- DATA ORANG TUA -->
        <div class="section">

          <div class="section-title">
            <span>3</span>
            Data Orang Tua / Wali
          </div>

          <div class="form-grid">

            <div class="form-group">

              <label>
                Nama Orang Tua / Wali
                <span class="required">*</span>
              </label>

              <input
                type="text"
                name="wali"
                placeholder="Nama orang tua / wali"
                required
              >

            </div>


            <div class="form-group">

              <label>
                Hubungan
                <span class="required">*</span>
              </label>

              <select name="hubungan" required>

                <option value="">
                  -- Pilih --
                </option>

                <option value="Ayah">
                  Ayah
                </option>

                <option value="Ibu">
                  Ibu
                </option>

                <option value="Wali">
                  Wali
                </option>

              </select>

            </div>


            <div class="form-group">

              <label>
                Nomor WhatsApp
                <span class="required">*</span>
              </label>

              <input
                type="tel"
                name="whatsapp"
                placeholder="08xxxxxxxxxx"
                required
              >

            </div>


            <div class="form-group">

              <label>
                Email
              </label>

              <input
                type="email"
                name="email"
                placeholder="nama@email.com"
              >

            </div>

          </div>

        </div>


        <!-- PENGALAMAN -->
        <div class="section">

          <div class="section-title">
            <span>4</span>
            Pengalaman Sepak Bola
          </div>

          <div class="form-grid">

            <div class="form-group">

              <label>
                Pernah Bergabung dengan Klub?
              </label>

              <select name="pengalaman">

                <option value="">
                  -- Pilih --
                </option>

                <option value="Belum pernah">
                  Belum pernah
                </option>

                <option value="Pernah">
                  Pernah
                </option>

              </select>

            </div>


            <div class="form-group">

              <label>
                Nama Klub / SSB Sebelumnya
              </label>

              <input
                type="text"
                name="klub"
                placeholder="Jika pernah bergabung"
              >

            </div>


            <div class="form-group full">

              <label>
                Prestasi / Pengalaman
              </label>

              <textarea
                name="prestasi"
                placeholder="Contoh: Juara turnamen, pengalaman kompetisi, dll."
              ></textarea>

            </div>

          </div>

        </div>


        <!-- INFORMASI KESEHATAN -->
        <div class="section">

          <div class="section-title">
            <span>5</span>
            Informasi Kesehatan
          </div>

          <div class="form-grid">

            <div class="form-group full">

              <label>
                Riwayat Cedera / Kondisi Khusus
              </label>

              <textarea
                name="kesehatan"
                placeholder="Tuliskan jika ada riwayat cedera atau kondisi kesehatan yang perlu diketahui pelatih."
              ></textarea>

            </div>

          </div>

        </div>


        <!-- PERSETUJUAN -->
        <div class="agreement">

          <label>

            <input
              type="checkbox"
              required
            >

            <span>
              Saya menyatakan bahwa seluruh data yang saya
              berikan adalah benar dan dapat dipertanggungjawabkan.
              Saya menyetujui calon pemain mengikuti proses
              seleksi dan program pembinaan Akademi Garudayaksa.
            </span>

          </label>

        </div>


        <!-- SUBMIT -->
        <button
          type="submit"
          class="submit-btn"
        >
          DAFTAR SEKARANG 🦅⚽
        </button>

      </form>

    </div>


    <div class="footer">
      © 2026 Akademi Garudayaksa
    </div>

  </div>


  <script>

    const form =
      document.getElementById("registrationForm");

    const success =
      document.getElementById("successMessage");


    form.addEventListener("submit", function(event) {

      event.preventDefault();

      success.style.display = "block";

      success.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });

      form.reset();

    });

  </script>

</body>
</html>
