<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pendaftaran Academy Sepak Bola</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #061b12, #0b5d32);
      padding: 40px 20px;
      color: #222;
    }

    .container {
      max-width: 900px;
      margin: auto;
    }

    .header {
      text-align: center;
      color: white;
      margin-bottom: 30px;
    }

    .logo {
      width: 80px;
      height: 80px;
      margin: auto auto 15px;
      border-radius: 50%;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
    }

    .header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .header p {
      color: #d9f7e5;
    }

    .form-card {
      background: white;
      border-radius: 18px;
      padding: 35px;
      box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      color: #087a3d;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 18px;
      padding-bottom: 10px;
      border-bottom: 2px solid #e5e5e5;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: bold;
      margin-bottom: 7px;
      font-size: 14px;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #d5d5d5;
      border-radius: 9px;
      font-size: 15px;
      outline: none;
      transition: .2s;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #0a8f4d;
      box-shadow: 0 0 0 3px rgba(10,143,77,.1);
    }

    textarea {
      resize: vertical;
      min-height: 100px;
    }

    .gender {
      display: flex;
      gap: 20px;
      margin-top: 8px;
    }

    .gender label {
      font-weight: normal;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .gender input {
      width: auto;
    }

    .agreement {
      background: #f1faf5;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .agreement label {
      display: flex;
      gap: 10px;
      font-weight: normal;
      line-height: 1.5;
    }

    .agreement input {
      width: auto;
      margin-top: 4px;
    }

    .submit-btn {
      width: 100%;
      border: none;
      padding: 15px;
      border-radius: 10px;
      background: linear-gradient(135deg, #087a3d, #0aaa58);
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: .2s;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(8,122,61,.3);
    }

    .required {
      color: #e63946;
    }

    .footer {
      text-align: center;
      color: #d9f7e5;
      margin-top: 20px;
      font-size: 13px;
    }

    @media (max-width: 650px) {
      body {
        padding: 20px 12px;
      }

      .form-card {
        padding: 22px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .full {
        grid-column: auto;
      }

      .header h1 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <div class="logo">⚽</div>
      <h1>ACADEMY SEPAK BOLA</h1>
      <p>Formulir Pendaftaran Pemain Baru</p>
    </div>

    <div class="form-card">

      <form id="registrationForm">

        <!-- DATA PEMAIN -->
        <div class="section">
          <div class="section-title">👤 Data Pemain</div>

          <div class="form-grid">

            <div class="form-group full">
              <label>
                Nama Lengkap <span class="required">*</span>
              </label>
              <input
                type="text"
                name="nama"
                placeholder="Masukkan nama lengkap pemain"
                required
              >
            </div>

            <div class="form-group">
              <label>
                Tempat Lahir <span class="required">*</span>
              </label>
              <input
                type="text"
                name="tempat_lahir"
                placeholder="Contoh: Jakarta"
                required
              >
            </div>

            <div class="form-group">
              <label>
                Tanggal Lahir <span class="required">*</span>
              </label>
              <input
                type="date"
                name="tanggal_lahir"
                required
              >
            </div>

            <div class="form-group">
              <label>Jenis Kelamin <span class="required">*</span></label>

              <div class="gender">
                <label>
                  <input type="radio" name="jenis_kelamin" value="Laki-laki" required>
                  Laki-laki
                </label>

                <label>
                  <input type="radio" name="jenis_kelamin" value="Perempuan">
                  Perempuan
                </label>
              </div>
            </div>

            <div class="form-group">
              <label>
                Kelompok Umur <span class="required">*</span>
              </label>

              <select name="kelompok_umur" required>
                <option value="">-- Pilih Kelompok --</option>
                <option>U-8</option>
                <option>U-10</option>
                <option>U-12</option>
                <option>U-14</option>
                <option>U-16</option>
                <option>U-18</option>
              </select>
            </div>

            <div class="form-group">
              <label>
                Posisi Bermain <span class="required">*</span>
              </label>

              <select name="posisi" required>
                <option value="">-- Pilih Posisi --</option>
                <option>Penjaga Gawang (GK)</option>
                <option>Pemain Bertahan (DF)</option>
                <option>Gelandang (MF)</option>
                <option>Penyerang (FW)</option>
              </select>
            </div>

            <div class="form-group">
              <label>Nomor Punggung Favorit</label>
              <input
                type="number"
                name="nomor"
                min="1"
                max="99"
                placeholder="Contoh: 10"
              >
            </div>

            <div class="form-group full">
              <label>Alamat Lengkap <span class="required">*</span></label>
              <textarea
                name="alamat"
                placeholder="Masukkan alamat lengkap pemain"
                required
              ></textarea>
            </div>

          </div>
        </div>


        <!-- DATA ORANG TUA -->
        <div class="section">
          <div class="section-title">👨‍👩‍👦 Data Orang Tua / Wali</div>

          <div class="form-grid">

            <div class="form-group">
              <label>
                Nama Orang Tua / Wali <span class="required">*</span>
              </label>

              <input
                type="text"
                name="wali"
                placeholder="Nama orang tua / wali"
                required
              >
            </div>

            <div class="form-group">
              <label>
                Hubungan dengan Pemain <span class="required">*</span>
              </label>

              <select name="hubungan" required>
                <option value="">-- Pilih --</option>
                <option>Ayah</option>
                <option>Ibu</option>
                <option>Wali</option>
              </select>
            </div>

            <div class="form-group">
              <label>
                Nomor WhatsApp <span class="required">*</span>
              </label>

              <input
                type="tel"
                name="whatsapp"
                placeholder="Contoh: 081234567890"
                required
              >
            </div>

            <div class="form-group">
              <label>Email</label>

              <input
                type="email"
                name="email"
                placeholder="nama@email.com"
              >
            </div>

          </div>
        </div>


        <!-- INFORMASI TAMBAHAN -->
        <div class="section">
          <div class="section-title">⚽ Informasi Tambahan</div>

          <div class="form-grid">

            <div class="form-group">
              <label>Pernah Mengikuti Academy/Klub?</label>

              <select name="pengalaman">
                <option value="">-- Pilih --</option>
                <option>Belum pernah</option>
                <option>Pernah</option>
              </select>
            </div>

            <div class="form-group">
              <label>Nama Klub Sebelumnya</label>

              <input
                type="text"
                name="klub_sebelumnya"
                placeholder="Jika ada"
              >
            </div>

            <div class="form-group full">
              <label>Catatan / Informasi Kesehatan</label>

              <textarea
                name="catatan"
                placeholder="Tuliskan informasi penting yang perlu diketahui pelatih..."
              ></textarea>
            </div>

          </div>
        </div>


        <!-- PERSETUJUAN -->
        <div class="agreement">
          <label>
            <input type="checkbox" required>
            Saya menyatakan bahwa data yang saya isi adalah benar dan
            saya menyetujui pemain mengikuti proses seleksi serta program
            latihan Academy Sepak Bola.
          </label>
        </div>

        <button type="submit" class="submit-btn">
          DAFTAR SEKARANG ⚽
        </button>

      </form>

    </div>

    <div class="footer">
      © 2026 Academy Sepak Bola. All Rights Reserved.
    </div>

  </div>


  <script>
    document
      .getElementById("registrationForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        alert(
          "Pendaftaran berhasil dikirim! ⚽\n\n" +
          "Tim Academy akan menghubungi Anda untuk informasi seleksi."
        );

        this.reset();
      });
  </script>

</body>
</html>
